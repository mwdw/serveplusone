---
import '../styles/global.css';
import { SITE } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  /** Absolute URL of the social card image */
  image?: { url: string; width: number; height: number; alt?: string };
  type?: 'website' | 'article';
  published?: Date;
  modified?: Date;
  tags?: string[];
  /** Extra JSON-LD objects for this page */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  /** Show the reading-progress ball travelling along the baseline */
  progress?: boolean;
}

const {
  title,
  description = SITE.description,
  image,
  type = 'website',
  published,
  modified,
  tags = [],
  schema = [],
  noindex = false,
  progress = false,
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), Astro.site);
const ogImage = image ?? { url: new URL('/og-default.png', Astro.site).href, width: 1200, height: 630, alt: `${SITE.name}: ${SITE.tagline}` };

const person = {
  '@type': 'Person',
  '@id': new URL('/about#person', Astro.site).href,
  name: SITE.author.name,
  url: new URL('/about', Astro.site).href,
  sameAs: SITE.author.sameAs,
  knowsAbout: ['Tennis', 'Tennis analytics', 'Sports data visualisation', 'ATP Tour'],
};
const website = {
  '@type': 'WebSite',
  '@id': new URL('/#website', Astro.site).href,
  name: SITE.name,
  description: SITE.description,
  url: Astro.site!.href,
  inLanguage: SITE.lang,
  author: { '@id': person['@id'] },
  publisher: { '@id': person['@id'] },
};
const graph = { '@context': 'https://schema.org', '@graph': [website, person, ...schema] };
const path = Astro.url.pathname;
const current = (href: string) => (href === '/' ? path === '/' || path === '/index.html' : path.startsWith(href)) ? 'page' : undefined;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
    <meta name="author" content={SITE.author.name} />
    <meta name="generator" content={Astro.generator} />

    <meta name="theme-color" content="#142231" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f1f3f0" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:image" content={ogImage.url} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    {ogImage.alt && <meta property="og:image:alt" content={ogImage.alt} />}
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    {type === 'article' && <meta property="article:author" content={new URL('/about', Astro.site).href} />}
    {tags.map((t) => <meta property="article:tag" content={t} />)}

    <!-- X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={`@${SITE.author.x}`} />
    <meta name="twitter:creator" content={`@${SITE.author.x}`} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />

    <!-- Theme: follows the system unless the reader picks one -->
    <script is:inline>
      try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch {}
      // The logo's ball lands in the box on the first page of each visit only.
      try { if (!sessionStorage.getItem('spo-seen')) { document.documentElement.classList.add('first-visit'); sessionStorage.setItem('spo-seen', '1'); } } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="frame">
      <header class="site-header">
        <span class="centre-mark" aria-hidden="true"></span>
        {progress && <span class="rally-ball" aria-hidden="true"></span>}
        <a class="wordmark" href="/" aria-label={`${SITE.name}, home`}>
          <svg class="mark" viewBox="0 0 28 28" aria-hidden="true">
            <path class="mk-net" d="M2 14h24" />
            <path class="mk-centre" d="M14 2.5v23" />
            <circle class="mk-ball" cx="20" cy="20" r="2.9" />
          </svg>
          <span class="wm-text">{SITE.name}</span>
        </a>
        <nav class="nav" aria-label="Primary">
          <a href="/" aria-current={current('/') ?? current('/posts') ?? current('/topics')}>Posts</a>
          <a href="/about" aria-current={current('/about')}>About</a>
        </nav>
      </header>
      <main id="main" class="court">
        <slot />
      </main>
      <div class="net" aria-hidden="true"></div>
      <footer class="site-footer">
        <span>© {new Date().getFullYear()} {SITE.author.name}</span>
        <nav aria-label="Footer">
          <a href={SITE.author.url} rel="me">X</a>
          <a href="/rss.xml">RSS</a>
          <button class="theme-toggle" type="button" data-theme-toggle>Day session</button>
        </nav>
      </footer>
    </div>
    <script is:inline>
      (() => {
        const btn = document.querySelector('[data-theme-toggle]');
        if (!btn) return;
        const root = document.documentElement;
        const sysDark = matchMedia('(prefers-color-scheme: dark)');
        const isDark = () => (root.dataset.theme ? root.dataset.theme === 'dark' : sysDark.matches);
        // Tennis names for the themes: day session (light) and night session (dark).
        const label = () => {
          btn.textContent = isDark() ? 'Day session' : 'Night session';
          btn.setAttribute('aria-label', isDark() ? 'Switch to light theme' : 'Switch to dark theme');
        };
        label();
        sysDark.addEventListener('change', label);
        btn.addEventListener('click', () => {
          const next = isDark() ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch {}
          label();
        });
      })();
    </script>
  </body>
</html>
