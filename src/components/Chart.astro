---
import { Picture } from 'astro:assets';
import type { PostImage } from '../lib/posts';

interface Props {
  img: PostImage;
  sizes: string;
  /** Above the fold: load eagerly with high priority. */
  priority?: boolean;
}
const { img, sizes, priority = false } = Astro.props;
const width = img.src.width;
---

<Picture
  src={img.src}
  alt={img.alt}
  formats={['avif']}
  fallbackFormat="webp"
  widths={[480, 720, 960, 1280, 1600, 2000, 2600].filter((w) => w <= width).concat(width < 480 ? [width] : [])}
  sizes={sizes}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  decoding="async"
  quality={88}
/>
