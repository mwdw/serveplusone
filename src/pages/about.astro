---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { SITE } from '../site.config';
import portrait from '../assets/matt.jpg';

const description = `${SITE.author.name} works in tech and writes about tennis strategy, playstyle shifts and the future of the game, through data. Also behind The Racquet on Substack and courtspeed.com.`;
const profile = {
  '@type': 'ProfilePage',
  '@id': new URL('/about', Astro.site).href,
  url: new URL('/about', Astro.site).href,
  name: `About ${SITE.author.name}`,
  mainEntity: { '@id': new URL('/about#person', Astro.site).href },
};
---

<Base title="About" description={description} schema={[profile]}>
  <div class="row">
    <div class="alley"></div>
    <header class="play post-head">
      <h1>{SITE.author.name}</h1>
      <Image class="portrait" src={portrait} alt={`${SITE.author.name}`} widths={[160, 320]} sizes="160px" width={160} height={160} format="webp" quality={85} loading="eager" />
    </header>
  </div>
  <div class="row">
    <div class="alley"></div>
    <div class="play prose col page-body">
      <p>
        Hi, I'm Matt. I work in tech but also think quite a lot about tennis strategy, playstyle shifts, and what tennis
        might look like in the future. You can find me on X <a href={SITE.author.url} rel="me">here</a>, read my older
        long-form tennis analysis <a href="https://theracquet.substack.com/" rel="me">here</a>, and find the court speed
        database <a href="https://courtspeed.com/" rel="me">here</a>.
      </p>
      <p>Usually found hitting fuzzy yellow balls or running up mountains.</p>
      <p>Contact: infotheracquet [at] gmail [dot] com</p>
    </div>
  </div>
</Base>
